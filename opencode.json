{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "core",
  "instructions": [
    "docs/project/principles.md",
    "docs/process/development-workflow.md",
    "docs/process/teammate-boundaries.md",
    "docs/project/current-state.md"
  ],
  "mcp": {
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "{env:STITCH_API_KEY}"
      },
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--isolated",
        "--viewport-size",
        "390x844",
        "--allowed-origins",
        "http://localhost:5173;http://localhost:4173",
        "--output-dir",
        ".playwright-mcp"
      ],
      "environment": {
        "PLAYWRIGHT_MCP_EXECUTABLE_PATH": "{env:PLAYWRIGHT_BROWSER}"
      },
      "enabled": true
    }
  }
}
