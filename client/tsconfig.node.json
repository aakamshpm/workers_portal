{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/node",
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "src/entries.test.ts",
    "src/sw.test.ts",
    "src/shared/theme.test.ts",
    "src/shared/index.test.ts",
    "src/shared/fonts.test.ts",
    "src/shared/components/icons.source.test.ts",
    "scripts/*.mjs"
  ]
}
