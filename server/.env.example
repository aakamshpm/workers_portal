DATABASE_URL="postgresql://wage:wage@localhost:5432/wage"
JWT_SECRET="change-me-to-a-long-random-string"
HMAC_SECRET="change-me-too"
PORT=4000

# Tests write rows, so they run against their own database and leave the
# development ledger alone. Create it once with:
#   docker exec compose-db-1 psql -U wage -d postgres -c "CREATE DATABASE wage_test OWNER wage;"
#   DATABASE_URL="postgresql://wage:wage@localhost:5432/wage_test" npx prisma migrate deploy
TEST_DATABASE_URL="postgresql://wage:wage@localhost:5432/wage_test"

# Textbee (https://textbee.dev). Required to send SMS.
# If unset, send() fails. It does not pretend delivery.
#
# The free plan allows 50 messages a day and 300 a month, and every recipient
# counts as one message. Each offer costs two (the offer, then the receipt), and
# each work or payment row costs two more. So a full demo run is roughly a dozen
# messages. Keep real sends for checking the gateway, and use the fake provider
# in tests.
# TEXTBEE_API_KEY=
# TEXTBEE_BASE_URL="https://api.textbee.dev"
